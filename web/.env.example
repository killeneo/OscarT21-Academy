# Copy to .env.local and fill in. Never commit real values.

# Public site origin used for canonical/hreflang URLs and OAuth redirects, e.g. https://example.org
# In local dev it must match the port you run on, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection string (local dev: see ../docker-compose.dev.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inclusive_dev

# Google sign-in: create an OAuth client (Web) and add
# <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram sign-in: create a bot with @BotFather, then /setdomain to your HTTPS domain
# (the Login Widget does not work on localhost without a tunnel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# E-mail (verification and password reset). No provider is wired in yet:
# in development mails are printed to the server console; MAIL_TRANSPORT=console does the same for `next start`.
MAIL_TRANSPORT=
